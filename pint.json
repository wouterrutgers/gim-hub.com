{
  "preset": "laravel",
  "rules": {
    "blank_line_before_statement": {
      "statements": [
        "break",
        "continue",
        "declare",
        "do",
        "for",
        "foreach",
        "if",
        "return",
        "switch",
        "throw",
        "try",
        "while"
      ]
    }
  }
}
